# Copy this file to .env ONLY if you want to run the scoring on your own computer.
# .env is ignored by git, so it is never uploaded. On GitHub, use Secrets instead (see README).

# Alpaca market data (free account): https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Price feed: "iex" is free. Leave as is.
DATA_FEED=iex

# Optional "smart money" signal (needs a paid Quiver Quant API key): https://api.quiverquant.com
QUIVER_API_KEY=
# auto = on when a key is present; false = always off
ENABLE_SMART_MONEY=auto
